# Build context for pi-server/Dockerfile is this repo root, but the Dockerfile
# copies only src/database, src/main/vaultSummary.js and pi-server/. Keep the
# context tiny — and never ship the live DB or the Electron-ABI node_modules.
node_modules
pi-server/node_modules
dist
dist-web
dist-electron
out
build
data
*.db
*.sqlite
.git
# ...except what the web build needs to name its commit (src/buildInfo.mjs)
!.git/HEAD
!.git/refs/heads
!.git/packed-refs
.env
.env.*
.vscode
.idea
docs
*.log
